name: Portafolio Frontend

on:
  push:
    paths:
      - "portafolio/frontend/**"
      - ".github/workflows/portafolio-frontend.yml"
  pull_request:
    paths:
      - "portafolio/frontend/**"
      - ".github/workflows/portafolio-frontend.yml"

jobs:
  frontend:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: portafolio/frontend

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
          cache-dependency-path: portafolio/frontend/package-lock.json

      - name: Install dependencies
        run: npm ci

      - name: Lint
        run: npm run lint

      - name: Typecheck
        run: npm run typecheck

      - name: Test
        run: npm test

      - name: Build
        run: npm run build
